#!/bin/ash
################################################################################
# Copilot CLI Compatibility Wrapper for iSH 32-bit Alpine Linux
# 
# Purpose: Provide safe fallback execution layer for Copilot CLI on i686
# Author: benholl94-cmyk
# Date: 2026-10-10
# 
# Architecture: i686 (32-bit x86)
# Shell: ash (Alpine Linux default)
# Environment: iSH on iOS with resource constraints (~512MB memory)
#
# Behavior:
#   - Detects unsupported 32-bit architecture
#   - Validates environment compatibility
#   - Routes to native binary (if somehow available)
#   - Falls back to safe no-op or web guidance mode
#   - Logs all operations for auditing
################################################################################

set -e

# ============================================================================
# 1. CONFIGURATION & DEFAULTS
# ============================================================================

# Script metadata
COPILOT_WRAPPER_VERSION="1.0.0"
COPILOT_WRAPPER_NAME="copilot-ish-wrapper"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="${COPILOT_LOG_DIR:-${HOME}/.copilot-logs}"
LOG_FILE="${LOG_DIR}/copilot-wrapper.log"
STATE_DIR="${HOME}/.copilot-state"
FALLBACK_MODE_FILE="${STATE_DIR}/.fallback-mode"

# Architecture identifiers
ARCH_DETECTED="$(uname -m)"
OS_DETECTED="$(uname -s)"
KERNEL_VERSION="$(uname -r)"

# Supported architectures (native binary only)
SUPPORTED_ARCHS="x86_64 amd64 aarch64 arm64"

# iSH/Alpine detection
ISH_DETECTED=0
ALPINE_DETECTED=0

# Verbosity levels
VERBOSITY="${COPILOT_VERBOSITY:-0}"
DEBUG="${COPILOT_DEBUG:-0}"

# Resource limits (iSH constraints)
MAX_MEMORY_MB=512
MAX_CPU_PERCENT=80
SAFE_TEMP_SIZE_MB=100

# ============================================================================
# 2. UTILITY FUNCTIONS
# ============================================================================

# Logging function
log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Ensure log directory exists
    mkdir -p "$LOG_DIR"
    
    # Write to log file
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
    
    # Print to stderr if not in silent mode
    if [ "$VERBOSITY" -gt 0 ] || [ "$level" = "ERROR" ] || [ "$level" = "WARN" ]; then
        echo "[$level] $message" >&2
    fi
}

# Debug logging (only if DEBUG=1)
debug() {
    if [ "$DEBUG" = "1" ]; then
        log "DEBUG" "$@"
    fi
}

# Error handler
die() {
    local message="$1"
    local exit_code="${2:-1}"
    log "ERROR" "$message"
    exit "$exit_code"
}

# Print colored output (safe for ash)
print_info() {
    echo "ℹ️  $*"
}

print_warn() {
    echo "⚠️  $*" >&2
}

print_error() {
    echo "❌ $*" >&2
}

print_success() {
    echo "✅ $*"
}

# ============================================================================
# 3. ARCHITECTURE DETECTION
# ============================================================================

detect_architecture() {
    debug "Detecting architecture: uname -m = $ARCH_DETECTED"
    
    case "$ARCH_DETECTED" in
        x86_64|amd64)
            log "INFO" "Detected 64-bit x86_64 architecture (native binary supported)"
            return 0
            ;;
        aarch64|arm64)
            log "INFO" "Detected ARM64 architecture (native binary supported)"
            return 0
            ;;
        i686|i386|i486|i586)
            log "WARN" "Detected 32-bit architecture: $ARCH_DETECTED (NOT supported by Copilot CLI)"
            log "WARN" "Native binary execution unavailable. Entering fallback mode."
            return 1
            ;;
        *)
            log "ERROR" "Unsupported architecture: $ARCH_DETECTED"
            return 2
            ;;
    esac
}

# ============================================================================
# 4. ENVIRONMENT VALIDATION
# ============================================================================

detect_ish_environment() {
    # Check for iSH-specific environment markers
    
    # Method 1: Check for iSH-specific files
    if [ -f "/.ish_root" ] || [ -f "/.iSH" ]; then
        ISH_DETECTED=1
        log "INFO" "iSH environment detected via filesystem markers"
    fi
    
    # Method 2: Check for Alpine-specific files
    if [ -f "/etc/alpine-release" ]; then
        ALPINE_DETECTED=1
        log "INFO" "Alpine Linux detected"
    fi
    
    # Method 3: Check shell
    if [ -n "$SHELL" ] && echo "$SHELL" | grep -q "ash"; then
        log "INFO" "Ash shell environment detected"
    fi
    
    # Method 4: Check uname
    if echo "$KERNEL_VERSION" | grep -qi "ish"; then
        ISH_DETECTED=1
        log "INFO" "iSH detected in kernel version string"
    fi
    
    if [ "$ISH_DETECTED" = "1" ] && [ "$ALPINE_DETECTED" = "1" ]; then
        log "INFO" "Confirmed: iSH Alpine Linux environment"
        return 0
    else
        log "WARN" "iSH/Alpine detection inconclusive (ISH=$ISH_DETECTED, ALPINE=$ALPINE_DETECTED)"
        return 1
    fi
}

validate_environment() {
    local validation_passed=0
    
    log "INFO" "=== Environment Validation ==="
    log "INFO" "OS: $OS_DETECTED"
    log "INFO" "Architecture: $ARCH_DETECTED"
    log "INFO" "Kernel: $KERNEL_VERSION"
    log "INFO" "Shell: $SHELL"
    log "INFO" "User: $(whoami)"
    log "INFO" "Home: $HOME"
    
    # Validate required tools
    local required_tools="ash grep sed"
    for tool in $required_tools; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            log "ERROR" "Required tool not found: $tool"
            return 1
        fi
        debug "Found required tool: $tool"
    done
    
    # Check for optional tools
    local optional_tools="curl wget git python3"
    for tool in $optional_tools; do
        if command -v "$tool" >/dev/null 2>&1; then
            debug "Optional tool available: $tool"
        else
            debug "Optional tool not available: $tool"
        fi
    done
    
    # Validate writable directories
    if ! [ -w "$HOME" ]; then
        log "ERROR" "Home directory not writable: $HOME"
        return 1
    fi
    
    # Create state directory
    mkdir -p "$STATE_DIR" || {
        log "ERROR" "Cannot create state directory: $STATE_DIR"
        return 1
    }
    
    log "INFO" "Environment validation complete"
    return 0
}

# ============================================================================
# 5. RESOURCE MONITORING
# ============================================================================

check_available_memory() {
    # Try multiple methods to get available memory
    
    if command -v free >/dev/null 2>&1; then
        # Linux systems
        local available_kb=$(free | grep "^Mem:" | awk '{print $7}')
        local available_mb=$((available_kb / 1024))
        debug "Available memory: ${available_mb}MB"
        
        if [ "$available_mb" -lt 100 ]; then
            log "WARN" "Low memory condition: ${available_mb}MB available (threshold: 100MB)"
            return 1
        fi
        return 0
    fi
    
    # Fallback: assume sufficient memory
    debug "Cannot determine available memory; assuming sufficient"
    return 0
}

check_temp_space() {
    local temp_dir="${TMPDIR:-/tmp}"
    
    if command -v df >/dev/null 2>&1; then
        local available=$(df "$temp_dir" | tail -1 | awk '{print $4}')
        local available_mb=$((available / 1024))
        debug "Available temp space: ${available_mb}MB"
        
        if [ "$available_mb" -lt "$SAFE_TEMP_SIZE_MB" ]; then
            log "WARN" "Low temp space: ${available_mb}MB (threshold: ${SAFE_TEMP_SIZE_MB}MB)"
            return 1
        fi
        return 0
    fi
    
    debug "Cannot determine temp space; assuming sufficient"
    return 0
}

# ============================================================================
# 6. SAFE PATH HANDLING
# ============================================================================

setup_safe_path() {
    # Ensure PATH contains only safe, predictable directories
    local safe_path="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    
    # Check if copilot binary exists
    local copilot_bin=""
    for dir in /usr/local/bin /usr/bin ~/.local/bin; do
        if [ -f "$dir/copilot" ] && [ -x "$dir/copilot" ]; then
            copilot_bin="$dir/copilot"
            log "INFO" "Found copilot binary at: $copilot_bin"
            break
        fi
    done
    
    if [ -n "$copilot_bin" ]; then
        # Verify it's actually executable on this architecture
        if file "$copilot_bin" 2>/dev/null | grep -q "x86-64\|aarch64\|ARM"; then
            log "ERROR" "Copilot binary is 64-bit; cannot execute on 32-bit iSH"
            return 1
        fi
    fi
    
    export PATH="$safe_path"
    debug "Safe PATH configured: $PATH"
    return 0
}

# ============================================================================
# 7. FALLBACK MODE
# ============================================================================

enable_fallback_mode() {
    log "WARN" "Enabling fallback mode - native binary execution unavailable"
    
    mkdir -p "$STATE_DIR"
    touch "$FALLBACK_MODE_FILE"
    
    cat > "$STATE_DIR/.fallback-info" <<'EOF'
COPILOT CLI - FALLBACK MODE
============================

Your system (32-bit iSH Alpine) is not compatible with the native Copilot CLI binary.

REASON:
  - GitHub Copilot CLI only provides 64-bit builds (x86_64, aarch64)
  - Your system reports: i686 (32-bit x86)
  - iSH default configuration runs 32-bit Alpine Linux

AVAILABLE ALTERNATIVES:
============================

1. UPGRADE iSH TO 64-BIT (RECOMMENDED)
   - Open iSH Settings
   - Enable "Use x86_64" or 64-bit mode
   - Reinstall iSH with 64-bit support
   - Then retry copilot CLI installation

2. USE COPILOT IN WEB/EDITOR (IMMEDIATE)
   - GitHub.com web interface: github.com/login → Copilot Chat
   - VS Code / JetBrains IDEs: Install Copilot extension
   - These work on any device, any architecture

3. USE THIS WRAPPER IN SAFE MODE
   - Wrapper will simulate copilot commands
   - Outputs helpful messages instead of executing
   - Limited functionality, no native execution

SAFE MODE USAGE:
============================

  copilot --version          → Shows compatibility info
  copilot help               → Shows this message
  copilot chat "prompt"      → Prompts you to use web UI
  copilot auth login         → Safe auth guidance
  copilot auth logout        → Clears local auth state

DOCUMENTATION:
============================

  Log file: ~/.copilot-logs/copilot-wrapper.log
  State dir: ~/.copilot-state
  Version:  1.0.0 (iSH wrapper)

For full Copilot CLI features, upgrade to 64-bit or use web/editor versions.
EOF
    
    log "INFO" "Fallback mode enabled. Info written to $STATE_DIR/.fallback-info"
}

is_fallback_mode() {
    [ -f "$FALLBACK_MODE_FILE" ]
}

# ============================================================================
# 8. SAFE NO-OP COMMAND HANDLERS
# ============================================================================

cmd_help() {
    cat "$STATE_DIR/.fallback-info" 2>/dev/null || cat <<'EOF'
Copilot CLI - iSH 32-bit Compatibility Wrapper
Version: 1.0.0

This is a safe fallback wrapper for 32-bit iSH Alpine Linux.
Native Copilot CLI binaries are not compatible with your system.

RECOMMENDED ACTION:
  Upgrade iSH to 64-bit or use Copilot in your editor/web interface.

Usage:
  copilot [command] [options]

Commands (Safe Mode):
  help              Show this help message
  --version         Show version info
  auth login        Authentication guidance
  auth logout       Clear local auth
  status            Show system compatibility info
  logs              View wrapper logs

For full Copilot CLI, upgrade to a 64-bit environment.
EOF
}

cmd_version() {
    cat <<EOF
Copilot CLI Wrapper (iSH 32-bit Compatibility)
Version: $COPILOT_WRAPPER_VERSION
Architecture: $ARCH_DETECTED (NOT supported for native execution)
OS: $OS_DETECTED
Environment: iSH Alpine Linux

⚠️  This is a fallback wrapper. Native Copilot CLI not available.

For full functionality:
  1. Upgrade to 64-bit iSH
  2. Use Copilot in VS Code / JetBrains
  3. Use Copilot Chat at github.com
EOF
}

cmd_status() {
    cat <<EOF
=== Copilot CLI - System Compatibility Status ===

Architecture:           $ARCH_DETECTED
OS:                     $OS_DETECTED
Kernel:                 $KERNEL_VERSION
Shell:                  $SHELL

iSH Detected:           $ISH_DETECTED
Alpine Detected:        $ALPINE_DETECTED
Fallback Mode Active:   $(is_fallback_mode && echo 'YES' || echo 'NO')

Memory Available:       $(free 2>/dev/null | grep "^Mem:" | awk '{printf "%.0f MB", $7/1024}' || echo 'unknown')
Temp Space Available:   $(df /tmp 2>/dev/null | tail -1 | awk '{printf "%.0f MB", $4/1024}' || echo 'unknown')

Native Binary Support:  ❌ NOT AVAILABLE (32-bit system)
Safe Mode Support:      ✅ ACTIVE (Limited functionality)

User:                   $(whoami)
Home:                   $HOME
Log File:               $LOG_FILE
State Dir:              $STATE_DIR

RECOMMENDATION:
  This system cannot run native Copilot CLI binaries.
  Please use one of these alternatives:
    • Upgrade iSH to 64-bit mode
    • Use Copilot in VS Code / JetBrains IDE
    • Use Copilot Chat at https://github.com
EOF
}

cmd_auth_login() {
    cat <<EOF
GitHub Copilot - Authentication Guidance
=========================================

IMPORTANT: This system (32-bit iSH) cannot run the native authentication flow.

RECOMMENDED APPROACH:

Option 1: Use Web Authentication (FASTEST)
  1. Visit: https://github.com/login
  2. Authenticate your GitHub account
  3. Visit: https://github.com/settings/copilot
  4. Enable Copilot for your account
  5. Use Copilot in your editor or at github.com/copilot

Option 2: Use GitHub CLI (if available in 32-bit)
  1. Install: gh (GitHub CLI)
  2. Run: gh auth login
  3. Complete web device flow

Option 3: Manual Token (Advanced)
  1. Create a GitHub Personal Access Token:
     https://github.com/settings/tokens
  2. Select scopes: copilot, read:user
  3. Save token to: $HOME/.copilot-auth (chmod 600)
  4. Use token with compatible tools

CURRENT STATUS: No authentication token configured on this device.

For full CLI authentication support, upgrade to 64-bit environment.
EOF
    
    log "INFO" "User requested auth login (safe mode)"
}

cmd_auth_logout() {
    log "INFO" "User requested auth logout"
    
    # Remove any local auth files (if they exist)
    rm -f "$HOME/.copilot-auth" 2>/dev/null || true
    rm -f "$HOME/.copilot-token" 2>/dev/null || true
    
    print_success "Local authentication cleared"
    print_info "You can re-authenticate using 'copilot auth login'"
}

cmd_logs() {
    if [ -f "$LOG_FILE" ]; then
        print_info "Showing wrapper logs from: $LOG_FILE"
        echo ""
        tail -50 "$LOG_FILE"
    else
        print_warn "No log file found yet"
    fi
}

cmd_unsupported() {
    local cmd="$1"
    cat <<EOF
❌ Command not available: $cmd

This system runs in SAFE FALLBACK MODE due to 32-bit architecture.

Most Copilot CLI commands require native binary execution, which is not
available on your 32-bit iSH system.

AVAILABLE COMMANDS:
  copilot help           Show this help
  copilot --version      Show version info
  copilot status         Show system status
  copilot auth login     Authentication guidance
  copilot auth logout    Clear local auth
  copilot logs           View wrapper logs

NEXT STEPS:
  1. Upgrade iSH to 64-bit, OR
  2. Use Copilot in VS Code / JetBrains, OR
  3. Use Copilot Chat at https://github.com

For technical details, see:
  cat $STATE_DIR/.fallback-info
EOF
    log "INFO" "User attempted unavailable command: $cmd"
}

# ============================================================================
# 9. MAIN DISPATCHER
# ============================================================================

main() {
    # Initialize
    log "INFO" "=== Copilot CLI Wrapper Started ==="
    log "INFO" "Wrapper Version: $COPILOT_WRAPPER_VERSION"
    
    # Step 1: Validate environment
    if ! validate_environment; then
        die "Environment validation failed" 1
    fi
    
    # Step 2: Detect environment (iSH/Alpine)
    detect_ish_environment
    
    # Step 3: Detect architecture
    if ! detect_architecture; then
        # Architecture is unsupported
        enable_fallback_mode
    fi
    
    # Step 4: Check resources
    if ! check_available_memory; then
        log "WARN" "Proceeding despite low memory"
    fi
    
    if ! check_temp_space; then
        log "WARN" "Proceeding despite low temp space"
    fi
    
    # Step 5: Setup safe PATH
    if ! setup_safe_path; then
        log "WARN" "PATH setup encountered issues"
    fi
    
    # Step 6: Handle commands
    local cmd="${1:-help}"
    
    log "INFO" "Command received: $cmd"
    
    # Remove leading dashes for compatibility
    cmd=$(echo "$cmd" | sed 's/^-*//')
    
    if is_fallback_mode; then
        # Fallback mode: only safe commands available
        case "$cmd" in
            help)
                cmd_help
                ;;
            version|--version|-v)
                cmd_version
                ;;
            status|info)
                cmd_status
                ;;
            auth)
                local subcommand="${2:-help}"
                case "$subcommand" in
                    login)
                        cmd_auth_login
                        ;;
                    logout)
                        cmd_auth_logout
                        ;;
                    *)
                        cmd_unsupported "auth $subcommand"
                        exit 1
                        ;;
                esac
                ;;
            logs|log)
                cmd_logs
                ;;
            chat|ask|prompt)
                cat <<EOF
❌ Chat command not available in fallback mode

To use Copilot Chat, please:
  1. Visit: https://github.com/copilot/playground
  2. Or use your editor (VS Code, JetBrains)
  3. Or upgrade this system to 64-bit

Arguments provided: $*
EOF
                log "INFO" "User attempted chat command (not available)"
                ;;
            *)
                cmd_unsupported "$cmd"
                exit 1
                ;;
        esac
    else
        # Attempt native binary execution
        local native_binary=$(command -v copilot 2>/dev/null || echo "")
        
        if [ -n "$native_binary" ]; then
            log "INFO" "Delegating to native binary: $native_binary"
            exec "$native_binary" "$@"
        else
            log "ERROR" "Native binary not found in PATH"
            cmd_unsupported "$cmd"
            exit 1
        fi
    fi
    
    log "INFO" "=== Copilot CLI Wrapper Completed ==="
}

# ============================================================================
# 10. ENTRY POINT
# ============================================================================

main "$@"
exit 0
